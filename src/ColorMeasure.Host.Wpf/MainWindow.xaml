<Window x:Class="ColorMeasure.Host.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ColorMeasure.Host.Wpf.ViewModels"
        xmlns:local="clr-namespace:ColorMeasure.Host.Wpf"
        Title="{Binding WindowTitle}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建(_N)" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="打开(_O)..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="另存为(_A)..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="退出(_X)" Click="OnExitClicked" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="添加 patch" Command="{Binding AddPatchCommand}" InputGestureText="Insert" />
                <MenuItem Header="恢复默认配方" Command="{Binding ResetToDefaultsCommand}" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于" Click="OnAboutClicked" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="新建"   Command="{Binding NewCommand}" />
                <Button Content="打开…" Command="{Binding OpenCommand}" />
                <Button Content="保存"   Command="{Binding SaveCommand}" />
                <Separator />
                <Button Content="+ Patch" Command="{Binding AddPatchCommand}" />
                <Button Content="↑"     Command="{Binding MovePatchUpCommand}"   CommandParameter="{Binding ElementName=PatchesGrid, Path=SelectedItem}" ToolTip="上移" />
                <Button Content="↓"     Command="{Binding MovePatchDownCommand}" CommandParameter="{Binding ElementName=PatchesGrid, Path=SelectedItem}" ToolTip="下移" />
                <Button Content="删除"   Command="{Binding RemovePatchCommand}"  CommandParameter="{Binding ElementName=PatchesGrid, Path=SelectedItem}" />
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding StatusText}" /></StatusBarItem>
        </StatusBar>

        <!-- Main body: left = patch list, right = settings -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="600" />
                <GridSplitter Width="4" Background="#eee" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Patch list -->
            <DataGrid x:Name="PatchesGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding Patches}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#fafbfc"
                      RowHeight="32"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"        Binding="{Binding Id,   UpdateSourceTrigger=PropertyChanged}" Width="120" />
                    <DataGridTemplateColumn Header="色样" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Swatch}" CornerRadius="3" Width="36" Height="20"
                                        BorderBrush="#000" BorderThickness="0.5"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Hex}" FontSize="9"
                                               Foreground="{Binding PreviewTextColor}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="HEX"       Binding="{Binding Hex,  UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    <DataGridTemplateColumn Header="颜色…" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="…" Padding="6,0" Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Avg"       Binding="{Binding Avg,  UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="50" />
                    <DataGridTextColumn Header="Label"     Binding="{Binding Label,UpdateSourceTrigger=PropertyChanged}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Settings panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,8,14,14">
                    <TextBlock Text="配方" FontSize="14" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="名称" Style="{StaticResource LabelStyle}" />
                    <TextBox  Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="连接模式 (auto / usb)" Style="{StaticResource LabelStyle}" />
                    <TextBox  Text="{Binding Connect, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="测量前调零" Style="{StaticResource LabelStyle}" />
                    <CheckBox IsChecked="{Binding CalibrateBeforeStart}" Content="ZeroCal" />

                    <TextBlock Text="每 patch 等待时间 (ms)" Style="{StaticResource LabelStyle}" />
                    <TextBox  Text="{Binding SettleMs, UpdateSourceTrigger=PropertyChanged}" />

                    <Separator Margin="0,16,0,8" />
                    <TextBlock Text="目标色域" FontSize="14" FontWeight="Bold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding AllTargets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,2" Content="{Binding}" Click="OnTargetToggled"
                                          IsChecked="{Binding IsTargetSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:TargetToggleConverter.Instance}, ConverterParameter={Binding}}">
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,16,0,8" />
                    <TextBlock Text="通过条件" FontSize="14" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Max ΔE2000 (空 = 不限)" Style="{StaticResource LabelStyle}" />
                    <TextBox  Text="{Binding MaxDeltaE2000, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />

                    <TextBlock Text="Min coverage (空 = 不限)" Style="{StaticResource LabelStyle}" />
                    <TextBox  Text="{Binding MinCoverage, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />

                    <TextBlock Text="说明：留空 = 不参与该条件判定。" Foreground="#888" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
